# 12-factor config (Factor III): all config comes from the environment.
# Copy to .env for local dev; never commit real secrets. In prod these are
# injected by the platform (Supabase/Fly/Hetzner) or a secrets manager.

# --- Core ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database (Factor IV: backing service as attached resource) ---
DATABASE_URL=postgres://troopers:troopers@localhost:5432/troopers

# --- Auth ---
# Production: verify HS256 JWTs (matches Supabase's project JWT secret). When
# AUTH_JWT_SECRET is set, JWT verification is used and the static tokens below
# are ignored.
# AUTH_JWT_SECRET=your-supabase-jwt-secret-min-16-chars
# AUTH_JWT_ISSUER=https://<project>.supabase.co/auth/v1
# AUTH_JWT_AUDIENCE=authenticated
# AUTH_ROLE_CLAIM=role
#
# Local/dev fallback (used only when AUTH_JWT_SECRET is unset): token:role pairs.
API_AUTH_TOKENS=dev-admin-token:admin,dev-leader-token:leader,dev-parent-token:parent

# --- Security ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
TRUSTED_PROXY=false

# --- Feature flags (Factor III) ---
# Override any flag with FLAG_<NAME>=true|false
FLAG_REGISTRATION_REMINDERS=true
FLAG_PHOTO_GALLERIES=false

# --- Reminders engine ---
# Configurable lead times (days) — see PRD §5.13/§5.14.
REGISTRATION_REMINDER_LEAD_DAYS=60,30,14,0
